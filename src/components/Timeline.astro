---
import { resolveLang, useTranslations } from "../i18n/utils";
import experience from "../data/experience.json";
import type { Localized, Position, Span } from "../data/types";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

/*
  The Experience strip.

  The lede of this section claims two careers running in parallel since 2008.
  Printed as three lists one under the other, that claim is something the
  reader has to assemble from dates; drawn as three lanes on one axis, it is
  the first thing they see. That is the whole reason this exists — it is the
  section's argument, not an ornament on it.

  Every bar is drawn from the `from`/`to` the entry already carries, the same
  numbers the record below prints as prose (`types.ts`, `Span`). Nothing here
  is a second list of years that could drift from the first.

  Bars are packed: within a lane, a bar takes the first track whose last bar
  has already ended, so the academic ranks — which are mutually exclusive, one
  after another — read as one line, and a lane only grows a second track when
  two things genuinely overlapped. Every bar carries its own name, which is
  what makes packing readable at all, and the geometry below is sized so that
  the name fits (see "Labels" further down).

  No script: positions are percentages of a fixed axis, so the strip is as
  correct with JavaScript off as with it on (DESIGN.md §7).
*/

type Bar = Span & { key: string };
type Lane = { id: "teaching" | "engineering" | "education"; name: string; bars: Bar[] };

const positions = experience.positions as Position[];
const ranks = experience.ranks as Span[];
/* Education states its bounds as strings; it is the one file section that
   predates the strip, and the dates there are read by the CV generator too. */
const education = experience.education as { short: Localized; from: string; to: string }[];

/* The teaching lane draws the academic ranks, not the chair: one bar from
   2008 would say "he taught", where four say what the eighteen years were
   spent climbing. The chair itself is the record below, and so is the Arduino
   elective — a course is not a position, and on the axis it only added a
   track that said nothing the panel below does not say better. */
const lanes: Lane[] = (
  [
    {
      id: "teaching",
      name: t("experience.timeline.lane.teaching"),
      bars: ranks.map((r, i) => ({ ...r, key: `rank-${i}` })),
    },
    {
      id: "engineering",
      name: t("experience.timeline.lane.engineering"),
      bars: positions
        .filter((p) => p.lane === "engineering")
        .map((p, i) => ({ short: p.short, from: p.from, to: p.to, key: `pos-${i}` })),
    },
    {
      id: "education",
      name: t("experience.timeline.lane.education"),
      bars: education.map((e, i) => ({
        short: e.short,
        from: Number(e.from),
        to: Number(e.to),
        key: `edu-${i}`,
      })),
    },
  ] as Lane[]
).map((lane) => ({ ...lane, bars: [...lane.bars].sort((a, b) => a.from - b.from) }));

const all = lanes.flatMap((l) => l.bars);

/* The axis runs from the first year on it to this one. The right edge is
   "now" by construction, so a bar with no end date reaches it without anyone
   having to remember to extend the axis in January. */
const START = Math.min(...all.map((b) => b.from));
const END = new Date().getFullYear();
const SPAN = END - START;

/*
  Labels.

  A packed chart is only worth packing if every bar can say what it is, so the
  widths below are not decoration — they decide whether a name goes inside its
  bar or next to it, and the strip is sized so that the narrowest bar that has
  to hold a name can hold it.

  TRACK is the width the plot gets inside the widest shell the site has (72rem
  less its gutters), which is also the `min-width` the scroll box is given: any
  narrower and the figure scrolls rather than shrinking the chart below the
  width its own labels need.

  CHAR is exact rather than estimated — IBM Plex Mono advances 0.6em, and the
  labels are set at 0.625rem, so a character is 6px. The bars clip anyway, so
  a fallback face that is wider cuts the name instead of spilling it over the
  bar beside it.
*/
const LABEL_COL = 96; // 6rem, the lane-name column
const COL_GAP = 12; // 0.75rem between the name and its tracks
const PANEL_PAD = 32; // 1rem of card padding on each side
const SHELL = 1088; // 72rem less the 2rem gutter on each side
const TRACK = SHELL - PANEL_PAD - LABEL_COL - COL_GAP;

const CHAR = 6; // IBM Plex Mono at 0.625rem
const PAD_IN = 8; // breathing room for a name set inside its bar
const GAP_OUT = 6; // bar end to a name set beside it
const BAR_GAP = 2; // hairline between two bars that touch, taken off the width
const MIN_BAR = 10; // a degree defended inside one year still has to be visible

const name = (b: Bar): string => b.short[lang];
const textPx = (s: string): number => s.length * CHAR;
const years = (b: Bar): number => (b.to ?? END) - b.from;

/* A bar with no end date reaches the right edge of the plot, so a name that
   does not fit inside it has nowhere to go. The plot gives up that much width
   as a right-hand margin — the axis still maps linearly onto what is left, it
   is simply narrower than the track. */
const GUTTER = Math.max(
  0,
  ...all
    .filter((b) => b.to === null && textPx(name(b)) + PAD_IN > (years(b) / SPAN) * TRACK - BAR_GAP)
    .map((b) => textPx(name(b)) + GAP_OUT)
);
const PLOT = TRACK - GUTTER;

const pos = (y: number): number => ((y - START) / SPAN) * (PLOT / TRACK) * 100;
const barPx = (b: Bar): number => Math.max((years(b) / SPAN) * PLOT, MIN_BAR);

type Placed = {
  key: string;
  name: string;
  range: string;
  left: number;
  width: number;
  outside: boolean;
  flush: boolean;
  open: boolean;
};

const present = t("experience.timeline.present");

const place = (b: Bar): Placed => {
  const label = name(b);
  const width = (barPx(b) / TRACK) * 100;
  const left = pos(b.from);
  const outside = textPx(label) + PAD_IN > barPx(b) - BAR_GAP;
  return {
    key: b.key,
    name: label,
    range: `${b.from}–${b.to ?? present}`,
    left,
    width,
    outside,
    /* No room left of the edge for a name set beside the bar: it is pinned to
       the end of the track instead of running off it. */
    flush: outside && left + width + ((textPx(label) + GAP_OUT) / TRACK) * 100 > 100,
    open: b.to === null,
  };
};

/* First-fit packing. The bars arrive sorted by start year, so a bar goes on
   the first track that is free where it begins; a name set beside a bar holds
   its own space, or the next bar would be drawn over it.

   The tolerance is not optional. One rank ends in the year the next begins,
   and `left + width` for the first is the same percentage as `left` for the
   second only in arithmetic: in binary it lands a few parts in 10^14 above
   it, which is enough to send the whole progression onto a second track. */
const TOUCHING = 1e-9;
const pack = (bars: Bar[]): Placed[][] => {
  const tracks: { items: Placed[]; end: number }[] = [];
  for (const bar of bars) {
    const p = place(bar);
    const end = p.left + p.width + (p.outside ? ((textPx(p.name) + GAP_OUT) / TRACK) * 100 : 0);
    const free = tracks.find((tr) => tr.end <= p.left + TOUCHING);
    if (free) {
      free.items.push(p);
      free.end = end;
    } else {
      tracks.push({ items: [p], end });
    }
  }
  return tracks.map((tr) => tr.items);
};

const drawn = lanes.map((lane) => ({ ...lane, tracks: pack(lane.bars) }));
const placed = drawn.flatMap((l) => l.tracks.flat());

/* Four-year ticks, the coarsest grid that still puts a label near every
   transition on the chart. The end of the axis is labelled too: a bar that
   runs to the right edge of the plot means "still running", which it can only
   say if the edge itself carries a year. A regular tick is dropped when it
   would be drawn on top of that one. */
const PX_PER_YEAR = PLOT / SPAN;
const ticks: number[] = [];
for (let y = Math.ceil(START / 4) * 4; y < END; y += 4) {
  if ((END - y) * PX_PER_YEAR >= 4 * CHAR + 8) ticks.push(y);
}
ticks.push(END);

/*
  Geometry has to come from a stylesheet, not from `style` attributes: the CSP
  in scripts/build_headers.py carries no 'unsafe-hashes', which bars style
  attributes outright (the same reason the citation bars in Research.astro are
  written this way). An inline <style> *element* is hashed like any other and
  the policy stays strict.

  The gridlines are one background per tick on the track, positioned by the
  same percentages as the ticks under it, so a bar edge and its year line up.
*/
const gridlines = ticks
  .map(() => "linear-gradient(var(--color-border),var(--color-border))")
  .join(",");
const gridpos = ticks.map((y) => `${pos(y).toFixed(3)}% 0`).join(",");
const geometry = [
  `.tl-grid{min-width:${TRACK + LABEL_COL + COL_GAP}px}`,
  ...placed.map(
    (p) =>
      `.tl-${p.key}{left:${p.left.toFixed(3)}%;width:calc(${p.width.toFixed(3)}% - ${BAR_GAP}px)}`
  ),
  ...ticks.map((y) => `.tl-t${y}{left:${pos(y).toFixed(3)}%}`),
  `.tl-track{background-image:${gridlines};background-position:${gridpos};` +
    `background-size:1px 100%;background-repeat:no-repeat}`,
].join("");
---

<figure class="mt-10">
  <figcaption class="label" id="tl-caption">{t("experience.timeline.title")}</figcaption>

  <style is:inline set:html={geometry}></style>

  <div class="tl-scroll panel mt-4" tabindex="0" role="group" aria-labelledby="tl-caption">
    <div class="tl-grid">
      {
        drawn.map((lane) => (
          <div class={`tl-lane tl-lane--${lane.id}`}>
            {/* A `p` and not a heading: the section already runs h2 → h3, and
                a fourth level here for three words would break that order for
                one group label. The list takes its name from it instead. */}
            <p class="label tl-lane-name" id={`tl-lane-${lane.id}`}>
              {lane.name}
            </p>
            <div class="tl-tracks" aria-hidden="true">
              {lane.tracks.map((track) => (
                <div class="tl-track">
                  {track.map((p) => (
                    <span
                      class={`tl-bar tl-${p.key}${p.open ? " tl-bar--open" : ""}${
                        p.outside ? " tl-bar--out" : ""
                      }${p.flush ? " tl-bar--flush" : ""}`}
                    >
                      <span class="tl-bar-label">{p.name}</span>
                    </span>
                  ))}
                </div>
              ))}
            </div>
            {/* The bars are geometry; this is the same content as text, in the
                order it happened, for a reader who is not looking at it. */}
            <ul class="sr-only" aria-labelledby={`tl-lane-${lane.id}`}>
              {lane.tracks.flat().map((p) => (
                <li>
                  {p.name}, <span class="data">{p.range}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="tl-axis" aria-hidden="true">
        <span></span>
        <span class="tl-ticks">
          {
            ticks.map((y) => (
              <span class={`data tl-tick tl-t${y}${y === END ? " tl-tick--end" : ""}`}>{y}</span>
            ))
          }
        </span>
      </div>
    </div>
  </div>
</figure>
