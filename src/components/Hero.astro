---
import { resolveLang, useTranslations } from "../i18n/utils";
import type { UIKey } from "../i18n/ui";
import Facts from "./Facts.astro";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const VIEWER_URL = "https://webviewer.ladetec.com/";

const layerKeys = [1, 2, 3].map((n) => `hero.layer.${n}` as UIKey);
---

<section id="top" class="shell pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] md:gap-14">
    <div>
      <p class="label">{t("hero.greeting")}</p>

      <h1 class="mt-4 text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.05] font-bold tracking-tight">
        {t("hero.name")}
      </h1>

      <p class="mt-5 text-[clamp(1.125rem,2.2vw,1.5rem)] leading-snug text-text">
        {t("hero.tagline")}
      </p>

      <p class="mt-6 text-sm text-muted">{t("hero.bio")}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={lang === "es" ? "/cv.es.pdf" : "/cv.pdf"}
          class="t-fast rounded border border-accent bg-accent px-4 py-2.5 text-sm font-medium text-bg hover:border-accent-hover hover:bg-accent-hover"
        >
          {t("hero.cta.cv")}
        </a>
        <a
          href="#system"
          class="t-fast rounded border border-border px-4 py-2.5 text-sm font-medium text-text hover:border-accent hover:text-accent"
        >
          {t("hero.cta.system")}
        </a>
        <a href="#contact" class="t-fast px-2 py-2.5 text-sm text-muted hover:text-accent">
          {t("hero.cta.contact")}
        </a>
      </div>
    </div>

    <!--
      Same shape as the About aside: portrait, then a label and a ticked list.
      The three layers are named once and only here — the tagline says them as
      a sentence, so repeating them in prose underneath would be the third
      telling. One accent for all three: colour-coding would spend three
      signals on three things that are not in opposition (DESIGN.md §1).
    -->
    <aside>
      <img
        src="/img/avatar/vladimir-3d.webp"
        alt={t("hero.avatar.alt")}
        width="256"
        height="256"
        loading="eager"
        decoding="async"
        class="panel hidden w-full max-w-64 object-cover md:block"
      />

      <h2 class="label md:mt-10">{t("hero.layers.title")}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        {
          layerKeys.map((k) => (
            <li class="flex gap-2.5">
              <span class="text-accent" aria-hidden="true">
                &#8250;
              </span>
              <span>{t(k)}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

  <Facts />

  <!--
    Radar panel. The portfolio must never depend on an external service to render:
    the still frame below is a build-time asset, and the live viewer is a link out,
    not an iframe. See DESIGN.md §7 and the plan's Fase 2b.
  -->
  <figure class="panel mt-12 overflow-hidden">
    <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-2.5">
      <span class="label flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t("hero.radar.label")}
      </span>
      <a
        href={VIEWER_URL}
        target="_blank"
        rel="noopener"
        class="data t-fast text-xs text-muted hover:text-accent"
      >
        {t("hero.radar.live")} &rarr;
      </a>
    </div>

    <!--
      The loop is the product of the chain, so it animates — but animation is
      not negotiable against DESIGN.md §5: under `prefers-reduced-motion` the
      `<source>` wins and the browser fetches the last frame instead, never the
      loop. `<picture>` is what makes that a fetch decision rather than a hidden
      element, and it needs no script.

      Animated WebP, not GIF: the same twelve frames are 816 KB against the
      GIF's 2.0 MB. `gif2webp -lossy -q 70` — lossless from a GIF only reached
      1.6 MB, which was not worth the request.

      Lazy, and deliberately not `fetchpriority="high"`: measured, the panel
      starts at y=1435 on a 390px phone and y=914 on a 1440x900 desktop, so it
      is below the fold either way. Eager, it was the LCP at 6.9 s on simulated
      slow 4G — the page's largest element was one nobody had scrolled to yet.
      The `width`/`height` pair holds the space, so deferring it costs no CLS.
    -->
    <picture>
      <source media="(prefers-reduced-motion: reduce)" srcset="/img/radar-loop-still.webp" />
      <img
        src="/img/radar-loop.webp"
        alt={t("hero.radar.alt")}
        width="960"
        height="484"
        loading="lazy"
        decoding="async"
        class="block w-full bg-bg"
      />
    </picture>

    <figcaption class="border-t border-border px-4 py-2.5 text-xs text-muted">
      {t("hero.radar.caption")}
    </figcaption>
  </figure>
</section>
