---
import { resolveLang, useTranslations } from "../i18n/utils";
import type { UIKey } from "../i18n/ui";
import projects from "../data/projects.json";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const statusKey = (s: string): UIKey => `projects.status.${s}` as UIKey;
---

<section id="projects" class="section">
  <div class="shell">
    <p class="label">03</p>
    <h2 class="mt-2 text-[clamp(1.5rem,2.5vw,2rem)] font-semibold tracking-tight">
      {t("projects.title")}
    </h2>
    <p class="prose-col mt-5 text-muted">{t("projects.lede")}</p>

    <!--
      The index. Six projects at full depth is a long read, and a visitor who
      wants one of them should not have to scroll past the other five to find
      out they are there. It is a contents list, not a summary: year, name,
      status, and a jump. The depth stays below, unabridged.
    -->
    <nav class="mt-10" aria-labelledby="projects-index-title">
      <p class="label" id="projects-index-title">{t("projects.index.title")}</p>
      <ul class="mt-4 divide-y divide-border border-t border-b border-border">
        {
          projects.map((p) => (
            <li>
              <a
                href={`#project-${p.id}`}
                class="t-fast flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3 hover:text-accent"
              >
                <span class="data w-24 shrink-0 text-xs text-muted">{p.years}</span>
                <span class="min-w-0 flex-1 text-sm font-medium">{p.title[lang]}</span>
                <span class="data text-xs text-muted">{t(statusKey(p.status))}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-16 space-y-16">
      {
        projects.map((p, i) => (
          <article id={`project-${p.id}`} class="scroll-mt-24 border-t border-border pt-8">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <span class="data text-sm text-muted">{p.years}</span>
              <h3
                class:list={[
                  "flex-1 font-semibold tracking-tight",
                  i === 0 ? "text-[clamp(1.375rem,2.2vw,1.75rem)]" : "text-xl",
                ]}
              >
                {p.title[lang]}
              </h3>
              <span class={["scaffolding", "poc"].includes(p.status) ? "badge-warn" : "tag"}>
                {t(statusKey(p.status))}
              </span>
            </div>

            {/* The lead project carries the argument of the section, so its
                summary is set at reading size rather than body size. */}
            <p class:list={["prose-col mt-4 text-muted", i === 0 && "text-lg leading-relaxed"]}>
              {p.summary[lang]}
            </p>

            <div class="prose-col mt-6 space-y-4 text-sm text-muted" set:html={p.body[lang]} />

            {p.shot && (
              <figure class="mt-8 overflow-hidden rounded border border-border">
                <img
                  src={p.shot.src}
                  alt={p.shot.alt[lang]}
                  width={p.shot.width}
                  height={p.shot.height}
                  loading="lazy"
                  decoding="async"
                  class="block w-full bg-bg"
                />
                <figcaption class="border-t border-border px-4 py-2.5 text-xs text-muted">
                  {p.shot.caption[lang]}
                </figcaption>
              </figure>
            )}

            {p.note && (
              <p class="panel prose-col mt-6 border-l-2 border-l-warn p-4 text-sm text-muted">
                {p.note[lang]}
              </p>
            )}

            {p.outOfScope && (
              <div class="mt-6">
                <p class="label">{t("projects.scope.title")}</p>
                <ul class="mt-3 grid gap-1.5 text-sm text-muted sm:grid-cols-2">
                  {p.outOfScope[lang].map((s) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true">&#215;</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <ul class="mt-6 flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap gap-5">
              {p.links.demo && (
                <a
                  class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
                  href={p.links.demo}
                  target="_blank"
                  rel="noopener"
                >
                  {t("projects.demo")} &rarr;
                </a>
              )}
              {p.links.code && (
                <a
                  class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
                  href={p.links.code}
                  target="_blank"
                  rel="noopener"
                >
                  {t("projects.code")} &rarr;
                </a>
              )}
              {p.links.docs && (
                <a
                  class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
                  href={p.links.docs}
                  target="_blank"
                  rel="noopener"
                >
                  {t("projects.docs")} &rarr;
                </a>
              )}
            </div>

            {p.repos && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {p.repos.map((r) => (
                  <li>
                    <a
                      class="tag t-fast hover:border-accent hover:text-accent"
                      href={r.url}
                      target="_blank"
                      rel="noopener"
                    >
                      {r.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
