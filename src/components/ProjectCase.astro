---
/*
  One case, in full, on its own page.

  Nothing here is folded. The disclosure this used to sit behind existed
  because six cases stacked on the home page were a wall of qualification the
  reader had not asked for; a reader who opened `/projects/<id>/` has asked for
  exactly this one, so the argument prints open and the captures come first.
*/
import { resolveLang, useTranslations } from "../i18n/utils";
import type { UIKey } from "../i18n/ui";
import type { Project } from "../data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const statusKey = (s: string): UIKey => `projects.status.${s}` as UIKey;

/** The index card may carry a capture the case does not print again. */
const figures = project.shots?.filter((s) => !s.coverOnly) ?? [];

const links = [
  { key: "projects.demo" as UIKey, href: project.links.demo },
  { key: "projects.code" as UIKey, href: project.links.code },
  { key: "projects.docs" as UIKey, href: project.links.docs },
].filter((l) => l.href);
---

<article>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="data text-sm text-muted">{project.years}</span>
    <span class={["scaffolding", "poc"].includes(project.status) ? "badge-warn" : "tag"}>
      {t(statusKey(project.status))}
    </span>
  </div>

  <h1 class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] leading-tight font-semibold tracking-tight">
    {project.title[lang]}
  </h1>

  <p class="prose-col mt-5 text-lg leading-relaxed text-muted">{project.summary[lang]}</p>

  {
    figures.length > 0 && (
      <div class="mt-10 space-y-6">
        {figures.map((s) => (
          <figure
            class:list={[
              "overflow-hidden rounded border border-border",
              s.portrait && "mx-auto max-w-sm",
              s.plot && "mx-auto max-w-xl",
            ]}
          >
            <img
              src={s.src}
              alt={s.alt[lang]}
              width={s.width}
              height={s.height}
              loading="lazy"
              decoding="async"
              class="block w-full bg-bg"
            />
            <figcaption class="border-t border-border px-4 py-2.5 text-xs text-muted">
              {s.caption[lang]}
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }

  <div class="prose-col mt-10 space-y-4" set:html={project.body[lang]} />

  {
    project.outOfScope && (
      <div class="mt-10">
        <p class="label">{t("projects.scope.title")}</p>
        <ul class="prose-col mt-3 grid gap-1.5 sm:grid-cols-2">
          {project.outOfScope[lang].map((s) => (
            <li class="flex gap-2">
              <span aria-hidden="true">&#215;</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    project.note && (
      <p class="panel prose-col mt-8 border-l-2 border-l-warn p-4 text-sm text-muted">
        {project.note[lang]}
      </p>
    )
  }

  <ul class="mt-10 flex flex-wrap gap-2">
    {project.stack.map((s) => <li class="tag">{s}</li>)}
  </ul>

  {
    links.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-5">
        {links.map((l) => (
          <a
            class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
            href={l.href}
            target="_blank"
            rel="noopener"
          >
            {t(l.key)} &rarr;
          </a>
        ))}
      </div>
    )
  }

  {
    project.repos && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {project.repos.map((r) => (
          <li>
            <a
              class="tag t-fast hover:border-accent hover:text-accent"
              href={r.url}
              target="_blank"
              rel="noopener"
            >
              {r.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
