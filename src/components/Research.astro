---
import { resolveLang, useTranslations } from "../i18n/utils";
import Disclosure from "./Disclosure.astro";
import type { UIKey } from "../i18n/ui";
import type { Citations, Publication } from "../data/types";
import publicationsData from "../data/publications.json";
import citationsData from "../data/citations.json";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const publications = publicationsData as Publication[];

/* One Scholar URL for the page: the chart's provenance line and the link at
   the foot of the section are the same profile, so they read it from the same
   place rather than drifting apart. */
const SCHOLAR_URL = (citationsData as Citations).url;
const THESIS_URL =
  "https://repositorioinstitucional.buap.mx/items/a851e155-89f6-4b5f-92d7-a6d363365b4c/full";
/* The same file BUAP serves, hosted here as well. Its repository answers in
   twenty to forty seconds on a good day and 502s on a bad one, and the thesis
   is open access, so a visitor should not have to wait on it to read the work
   the site keeps citing. The record above stays as the link that proves it. */
const THESIS_PDF = "/papers/rodriguez-2022-buap-phd-thesis-reduct-computation.pdf";

/** Journal vs conference, shown as a tag on each entry. */
const typeKey = (type: string): UIKey => `research.type.${type}` as UIKey;

/** Publication groups, in the order they should be read. Empty groups are skipped. */
const groups = ["core", "radar", "teaching"] as const;
const grouped = groups
  .map((g) => ({
    id: g,
    label: `research.group.${g}` as UIKey,
    items: publications.filter((p) => p.group === g).sort((a, b) => b.year - a.year),
  }))
  .filter((g) => g.items.length > 0);

/*
  Citations per year.

  Every other figure on this page is computed from the repository, which is
  what makes it checkable. This one cannot be: the site has no way of knowing
  who cites it. So it is the one number that ships with its provenance printed
  beside it — the service, the profile, and the date it was read — and the
  caption carries all three (data/citations.json, `Citations`).

  Two things the caption has to say out loud. The chart starts in 2015, while
  Scholar's total counts earlier citations too, so the bars deliberately do not
  add up to the total and a reader should not be left discovering that. And the
  last year is still running, so its bar is short for a reason that has nothing
  to do with the work.

  It is plain markup with no script. The bars are hidden from assistive
  technology and the same numbers are given as a table, which is the readable
  form of a bar chart anyway.
*/
const citations = citationsData as Citations;
const perYear = citations.perYear;
const maxCitations = Math.max(...perYear.map((c) => c.count));
const firstChartYear = perYear[0].year;
/** The last bar is a year in progress, and the caption says so. */
const inProgressYear = perYear[perYear.length - 1].year;
const asOf = new Date(`${citations.asOf}T00:00:00Z`).toLocaleDateString(
  lang === "es" ? "es-ES" : "en-GB",
  { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }
);
/** Height unit in rem. The plot area is 6rem tall. */
const citationUnit = 6 / maxCitations;
---

<section id="research" class="section">
  <div class="shell">
    <p class="label">02</p>
    <h2 class="mt-2 text-[clamp(1.5rem,2.5vw,2rem)] font-semibold tracking-tight">
      {t("research.title")}
    </h2>
    <p class="prose-col mt-5 text-muted">{t("research.lede")}</p>

    <div class="panel mt-10 p-6">
      <p class="label">{t("research.thesis.title")}</p>
      <h3 class="mt-2 text-lg font-medium italic">{t("research.thesis.name")}</h3>
      <p class="prose-col mt-3 text-sm text-muted">{t("research.thesis.body")}</p>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <a
          href={THESIS_PDF}
          class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
        >
          {t("research.thesis.pdf")} &darr;
        </a>
        <a
          href={THESIS_URL}
          target="_blank"
          rel="noopener"
          class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
        >
          {t("research.thesis.repo")} &rarr;
        </a>
      </p>
    </div>

    <figure class="panel mt-6 p-4 sm:p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <figcaption class="label">{t("research.citations.title")}</figcaption>
        <p class="data text-xs text-muted">
          {
            t("research.citations.total", {
              total: citations.total,
              h: citations.hIndex,
              i10: citations.i10Index,
            })
          }
        </p>
      </div>

      <div class="mt-6 flex items-end gap-1 sm:gap-1.5" aria-hidden="true">
        {
          perYear.map((c) => (
            <div class="flex min-w-0 flex-1 flex-col items-center gap-2">
              <div
                class="flex w-full max-w-10 flex-col justify-end gap-px"
                style="height: 6rem"
                title={t("research.citations.bar", { count: c.count, year: c.year })}
              >
                {c.count > 0 && (
                  <div class="w-full bg-accent" style={`height: ${c.count * citationUnit}rem`} />
                )}
              </div>
              <span class="data text-[0.625rem] text-muted">{String(c.year).slice(2)}</span>
            </div>
          ))
        }
      </div>

      {
        /*
        The provenance line. It is not a footnote — it is the only thing that
        makes the bars above a measurement rather than a decoration, so it is
        rendered, not hidden, and it names the gap between the bars and the
        total instead of waiting for the reader to find it.
      */
      }
      <p class="mt-4 text-xs text-muted">
        {
          t("research.citations.source", {
            source: citations.source,
            asOf,
            first: firstChartYear,
            year: inProgressYear,
          })
        }
        <a
          href={citations.url}
          target="_blank"
          rel="noopener"
          class="data t-fast ml-1 text-accent underline underline-offset-2 hover:text-accent-hover"
        >
          {t("research.citations.profile")} &rarr;
        </a>
      </p>

      <table class="sr-only">
        <caption>{t("research.citations.title")}</caption>
        <thead>
          <tr>
            <th scope="col">{t("research.citations.year")}</th>
            <th scope="col">{t("research.citations.count")}</th>
          </tr>
        </thead>
        <tbody>
          {
            perYear.map((c) => (
              <tr>
                <th scope="row">{c.year}</th>
                <td>{c.count}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </figure>

    <h3 class="label mt-14">{t("research.publications.title")}</h3>

    {
      /*
      The same radio + `:has()` pattern the LAMULA chain uses (System.astro):
      a native fieldset, not `role="tablist"`. Half-built ARIA tabs read worse
      than no ARIA at all — a `tablist` whose children are labels rather than
      `role="tab"` elements promises arrow-key behaviour the markup does not
      have — while a radio group announces "1 of 3" and moves on arrow keys
      because that is what it actually is.
    */
    }
    <fieldset class="pub-tabs mt-6 min-w-0">
      <legend class="sr-only">{t("research.publications.title")}</legend>
      <div class="flex gap-2 overflow-x-auto border-b border-border sm:gap-6">
        {
          grouped.map((group, idx) => (
            <label class="pub-tab-label data flex cursor-pointer items-center gap-2 border-b-2 border-transparent px-1 pb-3 text-xs font-medium transition-colors sm:text-sm">
              <input
                type="radio"
                name="publication-tab"
                value={group.id}
                checked={idx === 0}
                class="pub-tab-input sr-only"
              />
              <span>{t(group.label)}</span>
              <span class="pub-tab-count rounded-full border border-border bg-surface px-2 py-0.5 text-[0.65rem] text-muted">
                {group.items.length}
              </span>
            </label>
          ))
        }
      </div>

      {
        grouped.map((group) => (
          <div class="pub-tab-panel mt-6" data-group={group.id}>
            <ul class="divide-y divide-border border-t border-border">
              {group.items.map((p) => {
                const rank = p.rank;
                return (
                  <li class="flex gap-4 py-5 sm:gap-5">
                    {/*
                    First page of the paper. It is the cheapest evidence the list
                    can carry, and it gives a column of metadata something to look
                    at. Decorative to assistive tech — the title and the link
                    beside it say everything the picture does — so it carries an
                    empty alt and is skipped by the keyboard, with the DOI/PDF
                    link under the entry as the real target.
                  */}
                    {p.thumb && (
                      <a
                        class="paper-thumb"
                        href={p.doi || p.pdf}
                        target="_blank"
                        rel="noopener"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        <img
                          src={p.thumb}
                          alt=""
                          width="320"
                          height="414"
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    )}
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                        <div class="flex min-w-0 flex-1 items-baseline gap-3">
                          <span class="data shrink-0 text-sm text-muted">{p.year}</span>
                          <h4 class="text-base font-medium">{p.title}</h4>
                        </div>
                        <div class="flex shrink-0 flex-col items-start gap-1.5 sm:items-end">
                          {p.type === "journal" ? (
                            <span class="inline-flex items-center gap-1.5 rounded border border-accent/50 bg-accent/15 px-2.5 py-1 font-mono text-xs font-medium text-accent">
                              <svg
                                class="h-3.5 w-3.5 shrink-0"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                              </svg>
                              {t(typeKey(p.type))}
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1.5 rounded border border-warn/50 bg-warn/15 px-2.5 py-1 font-mono text-xs font-medium text-warn">
                              <svg
                                class="h-3.5 w-3.5 shrink-0"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                              >
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                              </svg>
                              {t(typeKey(p.type))}
                            </span>
                          )}
                          {/*
                            Both links when an entry carries both. No entry
                            does today, but making them exclusive would mean a
                            PDF added next to an existing DOI silently stops
                            being reachable, and nothing on the page would say
                            so.
                          */}
                          {p.doi && (
                            <a
                              class="data t-fast text-xs text-accent underline underline-offset-2 hover:text-accent-hover"
                              href={p.doi}
                              target="_blank"
                              rel="noopener"
                            >
                              {t("research.doi")} &rarr;
                            </a>
                          )}
                          {p.pdf && (
                            <a
                              class="data t-fast text-xs text-accent underline underline-offset-2 hover:text-accent-hover"
                              href={p.pdf}
                              target="_blank"
                              rel="noopener"
                            >
                              {t("research.pdf")} &rarr;
                            </a>
                          )}
                        </div>
                      </div>
                      <p class="mt-1.5 text-sm text-muted">{p.authors.join(", ")}</p>
                      <p class="mt-1 text-sm text-muted">
                        <span class="italic">{p.venue}</span>
                        {p.detail && <span class="data ml-2 text-xs">{p.detail}</span>}
                      </p>

                      {/*
                    The quartile strip. It renders only for an entry that carries
                    a `rank`, and it always prints the ranking, the edition and
                    the category beside it — a quartile with no year is a number
                    a reader cannot check, and one with no category is a number
                    that chose its own ground (types.ts, `Rank`).
                  */}
                      {rank && (
                        <p class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                          <span class="flex gap-0.5" aria-hidden="true">
                            {[1, 2, 3, 4].map((q) => (
                              <span
                                class={`inline-block h-1.5 w-5 ${
                                  q <= 5 - rank.quartile ? "bg-accent" : "bg-border"
                                }`}
                              />
                            ))}
                          </span>
                          <span class="data text-xs text-muted">
                            Q{rank.quartile} &middot; {rank.source} {rank.year}
                          </span>
                          <span class="text-xs text-muted">{rank.category}</span>
                        </p>
                      )}
                      {/*
                    The abstract is the evidence, not the headline. Folded, the
                    list reads as a list; open, nothing has been withheld
                    (Disclosure.astro).
                  */}
                      <Disclosure label={t("research.abstract")} class="mt-3">
                        <p class="prose-col">{p.abstract[lang]}</p>
                      </Disclosure>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </fieldset>

    <p class="mt-8">
      <a
        href={SCHOLAR_URL}
        target="_blank"
        rel="noopener"
        class="data t-fast text-sm text-accent underline underline-offset-4 hover:text-accent-hover"
      >
        {t("research.scholar")} &rarr;
      </a>
    </p>
  </div>
</section>
