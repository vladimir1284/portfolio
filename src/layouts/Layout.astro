---
import { resolveLang, useTranslations } from "../i18n/utils";
import { ogLocale } from "../i18n/ui";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import "../styles/global.css";

/*
  Fonts are self-hosted, and that is a measured decision rather than a
  preference. Loaded from Google, the `<link rel=stylesheet>` to
  fonts.googleapis.com is render-blocking on a second origin — 251 ms of DNS,
  TLS and request for 1.4 KB — and the woff2 files it names can only be
  discovered after it parses, on a *third* origin. The h1 therefore painted
  twice: once in the fallback at FCP, again in Inter at 6.9 s, and that repaint
  was the LCP.

  Served from `dist/`, the faces are preloaded below on the connection the
  document already holds, so they are in flight before the stylesheet is
  parsed. `wght` rather than `standard`: the weight-only axis of Inter is
  48 KB against the full variable file's 71 KB, and nothing here varies optical
  size. Only the `latin` slice ships — the site's two locales need nothing
  past U+00FF (checked against every string in src/).
*/
import interWght from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import plexMono400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import plexMono500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";

interface Props {
  /** Page title. Defaults to the site title — only sub-pages override it. */
  title?: string;
  description?: string;
  /**
   * The locale-agnostic route this page serves: no leading slash, no locale
   * prefix. "" is the home page, "projects/" the project index. Canonical,
   * hreflang and og:url are all built from it, so a sub-page that forgets to
   * pass it would claim to be the home page in three places at once.
   */
  route?: string;
}

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title, description, route = "" } = Astro.props;
const pageTitle = title ?? t("site.title");
const pageDescription = description ?? t("site.description");

const canonicalURL = getAbsoluteLocaleUrl(lang, route);
const ogImageURL = new URL("/og-image.png", Astro.site).toString();
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Theme flash prevention — must run before paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
      })();
    </script>

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl("en", route)} />
    <link rel="alternate" hreflang="es" href={getAbsoluteLocaleUrl("es", route)} />
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en", route)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale[lang]} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!--
      Fonts. Same origin, so no preconnect buys anything — the connection is
      already open. `crossorigin` is still required on a font preload even
      then: fonts are fetched in CORS mode, and a preload whose mode does not
      match the later request is discarded and fetched again.
    -->
    <link rel="preload" href={interWght} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono500} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/webp" href="/img/avatar/vladimir-3d-favicon.webp" />
  </head>
  <body>
    <slot />
  </body>
</html>
